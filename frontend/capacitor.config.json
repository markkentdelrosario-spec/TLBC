{
  "appId": "com.onrender.tlbcfrontend",
  "appName": "The Life Builder Church",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "FirebaseAuthentication": {
      "skipNativeAuth": true,
      "providers": ["google.com", "facebook.com"]
    },
    "PushNotifications": {
      "presentationOptions": ["alert", "sound", "badge"]
    }
  }
}
