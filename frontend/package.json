{
  "name": "ksp-beneficiary-attendance-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/createSpaFallback.js",
    "build:android": "vite build --mode capacitor && node scripts/createSpaFallback.js && cap sync android",
    "assets:android": "capacitor-assets generate --android --assetPath=assets --iconBackgroundColor=#ffffff --iconBackgroundColorDark=#ffffff --splashBackgroundColor=#ffffff --splashBackgroundColorDark=#ffffff",
    "build:e2e": "vite build --mode e2e && node scripts/createSpaFallback.js",
    "test": "node --test",
    "test:e2e": "npm run build:e2e && playwright test",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^8.6.0",
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/push-notifications": "^8.1.3",
    "firebase": "^12.19.0",
    "html-to-image": "^1.11.13",
    "html5-qrcode": "^2.3.8",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5",
    "socket.io-client": "^4.8.4"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2",
    "@playwright/test": "^1.65.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "vite": "^6.0.1"
  }
}
